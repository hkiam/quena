// Quena plugin API, version 1.
//
// Decoders are streaming from the start (§2.12.3): the host pushes the body
// in chunks and collects output chunks, so a plugin never has to hold a
// 500 MB payload in its memory.
package quena:plugin@1.0.0;

interface decoder {
    /// How the host should present the output.
    enum representation {
        text,
        xml,
        json,
    }

    record info {
        /// Stable id, e.g. `io.github.hkiam.fast-infoset`.
        id: string,
        name: string,
        version: string,
        /// Inspector tab title, e.g. `Fast Infoset`.
        tab: string,
        output: representation,
    }

    get-info: func() -> info;

    /// Confidence 0..=100 that this decoder applies. Only the first bytes are passed.
    detect: func(content-type: option<string>, prefix: list<u8>) -> u8;

    /// One decoding run.
    resource session {
        constructor(content-type: option<string>);
        /// Feed the next chunk; returns output produced so far (may be empty).
        push: func(chunk: list<u8>) -> result<list<u8>, string>;
        /// End of input; returns the remaining output.
        finish: func() -> result<list<u8>, string>;
    }
}

/// Decodes single header values, e.g. `Authorization: Negotiate <token>`.
/// Added in API 1 without changing `decoder`, so existing plugins keep working.
interface header-inspector {
    record info {
        /// Stable id, e.g. `io.github.hkiam.auth-tokens`.
        id: string,
        name: string,
        version: string,
        /// Title shown above the decoded value.
        tab: string,
    }

    enum node-kind {
        /// Heading of a (nested) block.
        section,
        /// `name: value` row of the enclosing section.
        field,
        /// Explanatory text for the enclosing section.
        note,
        /// Preformatted text (e.g. a hex dump) with `name` as its caption.
        code,
    }

    /// One line of the result. WIT has no recursive types, so the tree is
    /// flattened in document order; `depth` is the nesting level (0 = top).
    record node {
        depth: u8,
        kind: node-kind,
        name: string,
        value: string,
    }

    get-info: func() -> info;

    /// Confidence 0..=100 that `inspect` understands this header.
    /// `name` is lower-case, `value` as sent on the wire.
    detect: func(name: string, value: string) -> u8;

    inspect: func(name: string, value: string) -> result<list<node>, string>;
}

/// Analyses a whole capture (or a selection) and returns a diagnostic report.
/// Added in API 1 without changing the other interfaces.
///
/// The host streams the sessions in batches (time order) into one `run`; `finish`
/// returns the report as JSON (schema: plugins/webdiag/REPORT.md). Credentials in
/// headers and URLs are redacted by the host before they reach the plugin (REPORT.md).
/// Deadlines: 10 s per `push` and for the constructor, 60 s for `finish`; the report
/// may be at most 64 MiB. A cancelled run is interrupted, even inside a call.
interface analyzer {
    record info {
        /// Stable id, e.g. `io.github.hkiam.webdiag`.
        id: string,
        name: string,
        version: string,
        /// Title of the report view.
        title: string,
    }

    /// Session timers in microseconds since the Unix epoch; durations in milliseconds.
    record timers {
        client-begin-request: option<u64>,
        client-done-request: option<u64>,
        server-connect-start: option<u64>,
        server-connected: option<u64>,
        server-begin-request: option<u64>,
        server-done-request: option<u64>,
        server-got-first-byte: option<u64>,
        server-done-response: option<u64>,
        client-done-response: option<u64>,
        dns-ms: option<u32>,
        tcp-connect-ms: option<u32>,
        tls-handshake-ms: option<u32>,
    }

    /// Non-secret claims of a JSON Web Token (signature, jti, nonce and personal claims such
    /// as sub, oid, email, upn, name are never included). Times are seconds since the epoch.
    record jwt-claims {
        alg: string,
        typ: option<string>,
        iss: option<string>,
        aud: list<string>,
        exp: option<u64>,
        nbf: option<u64>,
        iat: option<u64>,
        /// azp, appid or client_id (the client the token was issued to).
        client: option<string>,
        /// Entra ID tenant id (tid).
        tenant: option<string>,
        /// Token version (ver), e.g. "1.0" / "2.0".
        ver: option<string>,
        /// scp / scope, split at spaces.
        scopes: list<string>,
        roles: list<string>,
        /// Number of entries in a groups claim (not the groups themselves).
        groups: option<u32>,
        /// Entra ID groups overage (_claim_names / hasgroups).
        groups-overage: bool,
        /// Length of the encoded token in bytes.
        size: u32,
    }

    /// An OAuth request to a token/device/introspection endpoint (form body), facts only.
    record oauth-request {
        grant-type: option<string>,
        client-id: option<string>,
        scope: option<string>,
        /// redirect_uri without its query.
        redirect-uri: option<string>,
        has-code: bool,
        has-code-verifier: bool,
        has-refresh-token: bool,
        has-client-secret: bool,
        has-client-assertion: bool,
        /// client_secret_basic: an Authorization: Basic header on the token request.
        basic-client-auth: bool,
    }

    /// An OAuth/OIDC JSON response (token, error, device code), facts only.
    record oauth-response {
        error: option<string>,
        /// At most 300 bytes; e-mail addresses masked.
        error-description: option<string>,
        /// Entra ID error_codes, and AADSTS numbers found in the description.
        error-codes: list<u32>,
        error-uri: option<string>,
        /// Entra ID trace_id / correlation_id (support identifiers, not secrets).
        trace-id: option<string>,
        correlation-id: option<string>,
        token-type: option<string>,
        expires-in: option<u32>,
        has-access-token: bool,
        has-refresh-token: bool,
        has-id-token: bool,
        scope: option<string>,
        access-token: option<jwt-claims>,
        id-token: option<jwt-claims>,
    }

    /// An OpenID Connect discovery document (/.well-known/openid-configuration).
    record oidc-discovery {
        issuer: option<string>,
        authorization-endpoint: option<string>,
        token-endpoint: option<string>,
        jwks-uri: option<string>,
        end-session-endpoint: option<string>,
    }

    /// Authentication facts of a session (REPORT.md "Authentication facts").
    record auth-info {
        /// Claims of a JWT sent as Authorization: Bearer / DPoP (none for opaque tokens).
        bearer: option<jwt-claims>,
        /// Size of an opaque bearer token (bytes), when it is not a JWT.
        opaque-bearer: option<u32>,
        oauth-request: option<oauth-request>,
        oauth-response: option<oauth-response>,
        discovery: option<oidc-discovery>,
    }

    /// Character encoding facts of a textual body (JSON, XML, HTML, text/*, forms …),
    /// determined by the host from the first 256 KiB of the decoded body (REPORT.md). Only
    /// facts leave the host, never body content.
    record text-info {
        /// `charset` of the Content-Type as sent (at most 64 bytes, else `<n bytes>`).
        header-charset: option<string>,
        /// WHATWG name the header label resolves to (`latin1` → `windows-1252`); none if
        /// absent or unknown.
        header-resolved: option<string>,
        /// Declaration inside the document (`<?xml encoding>`, HTML `<meta charset>`), as
        /// written (at most 64 bytes, else `<n bytes>`).
        document-charset: option<string>,
        document-resolved: option<string>,
        /// Byte order mark: `UTF-8`, `UTF-16LE`, `UTF-16BE`.
        bom: option<string>,
        /// Effective charset (WHATWG name) and where it came from: `bom`, `header`,
        /// `document` or `default` (BOM > header > document > default of the type).
        effective: string,
        source: string,
        /// The header or the document names a charset the label table does not know.
        unknown-label: bool,
        /// Bytes examined (a prefix of the decoded body).
        sampled: u64,
        /// Any byte ≥ 0x80 (or UTF-16).
        non-ascii: bool,
        /// The sample is valid UTF-8 (a sequence cut at the sample end is allowed).
        utf8-valid: bool,
        /// Malformed sequences when decoding with the effective charset.
        decode-errors: u32,
        /// U+FFFD already present in the (valid) text.
        replacement-chars: u32,
        /// Traces of UTF-8 decoded as Latin-1/windows-1252 and encoded again (`Ã¼`).
        double-encoded: u32,
        /// NUL bytes (outside UTF-16).
        nul-bytes: u32,
        /// The decoded body starts with the magic bytes of a compressed stream: `gzip`,
        /// `zstd` or `deflate`.
        looks-compressed: option<string>,
    }

    record session {
        id: u64,
        /// `http`, `tunnel` or `websocket`.
        kind: string,
        /// Start in microseconds since the Unix epoch.
        started: u64,
        duration-ms: option<u32>,
        method: string,
        /// Absolute URL (scheme, host, path, query) with user info and sensitive or long
        /// query/fragment values replaced by `%3Cn%20bytes%3E` (REPORT.md); at most
        /// 8 KiB. Tunnels (`kind` = `tunnel`) carry the authority form `host:port`.
        url: string,
        host: string,
        /// `HTTP/1.1`, `HTTP/2`, … as captured.
        version: string,
        /// 0 if there was no response.
        status: u16,
        /// Connect failure, timeout, reset, abort … as reported by the proxy.
        error: option<string>,
        /// Body sizes: as transferred (wire) and decoded. `response-decoded-bytes` is a
        /// lower bound above 256 MiB (decoding stops there).
        request-bytes: u64,
        response-bytes: u64,
        response-decoded-bytes: u64,
        content-type: string,
        /// Allow-listed headers in wire order (at most 256), secrets redacted, values
        /// at most 8 KiB (see REPORT.md).
        request-headers: list<tuple<string, string>>,
        response-headers: list<tuple<string, string>>,
        timers: timers,
        client-connection: option<u64>,
        /// Whether the upstream connection was reused (false also when unknown).
        server-connection-reused: bool,
        /// Upstream TLS version, e.g. `TLSv1.3`.
        tls-version: option<string>,
        process: string,
        /// Fingerprints of the bodies (none when not computed, e.g. too large).
        request-body-hash: option<u64>,
        response-body-hash: option<u64>,
        /// Encoding facts of textual bodies (none for other types, empty or undecodable
        /// bodies).
        request-text: option<text-info>,
        response-text: option<text-info>,
        /// The Content-Encoding could not be decoded: `unsupported: <coding>` (a coding the
        /// host does not know) or `invalid: <codings>: <error>` (corrupt data). None when
        /// the body was stored truncated.
        request-decoding-error: option<string>,
        response-decoding-error: option<string>,
        /// OAuth / OpenID Connect facts (none when the session has nothing of that kind).
        auth: option<auth-info>,
    }

    get-info: func() -> info;

    /// Profiles and default options as JSON, for the UI (schema: REPORT.md).
    describe: func(lang: string) -> string;

    resource run {
        /// `options` as JSON: profile, thresholds, network profiles, language.
        constructor(options: string);
        push: func(batch: list<session>) -> result<_, string>;
        /// The report as JSON.
        finish: func() -> result<string, string>;
    }
}

world plugin {
    export decoder;
}

world header-plugin {
    export header-inspector;
}

world analyzer-plugin {
    export analyzer;
}
